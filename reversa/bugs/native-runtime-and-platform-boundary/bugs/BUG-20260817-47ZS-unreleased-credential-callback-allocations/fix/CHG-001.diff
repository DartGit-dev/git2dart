+      final end = source.indexOf(
+        'Pointer<git_credential> sshKeyFromAgent',
+        start,
+      );
+      final sshKeySource = source.substring(start, end);
+
+      expect(start, isNonNegative);
+      expect(end, greaterThan(start));
+      expect(sshKeySource, contains('using((arena)'));
+      expect(sshKeySource, contains('arena<Pointer<git_credential>>()'));
+      expect(
+        RegExp(r'\.toChar\(arena\)').allMatches(sshKeySource),
+        hasLength(4),
+      );
+      expect(sshKeySource, isNot(contains('calloc<')));
+      expect(sshKeySource, isNot(contains('.toCharAlloc()')));
+    });

