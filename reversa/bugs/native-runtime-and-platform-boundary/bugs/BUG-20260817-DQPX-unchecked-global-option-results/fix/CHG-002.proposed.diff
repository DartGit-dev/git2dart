```javascript

const fs = require('fs');
const os = require('os');
const path = require('path');
const {execFileSync} = require('child_process');
const sourcePath = 'F:/git2dart/lib/src/libgit2.dart';
const before = fs.readFileSync(sourcePath, 'utf8');
const lines = before.split(/\r?\n/);
let changed = 0;
for (let i = 0; i < lines.length; i++) {
  const trimmed = lines[i].trimStart();
  if (!trimmed.startsWith('libgit2Runtime.options.git_libgit2_opts_')) continue;
  let end = i;
  while (end < lines.length && !lines[end].includes(';')) end++;
  if (end >= lines.length) throw new Error('Unterminated option call at line ' + (i + 1));
  const after = lines.slice(end + 1).join('\n');
  if (/^\s*checkErrorAndThrow\(/.test(after)) continue;
  const indent = lines[i].match(/^\s*/)[0];
  lines[i] = indent + 'final error = ' + trimmed;
  lines.splice(end + 1, 0, indent + 'checkErrorAndThrow(error);');
  changed++;
  i = end + 1;
}
if (changed !== 40) throw new Error('Expected 40 unchecked calls, transformed ' + changed);
const after = lines.join('\n');
const tempRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'dqpx-'));
const beforePath = path.join(tempRoot, 'before.dart');
const afterPath = path.join(tempRoot, 'after.dart');
fs.writeFileSync(beforePath, before);
fs.writeFileSync(afterPath, after);
let diff;
try {
  diff = execFileSync('git', ['diff', '--no-index', '--', beforePath, afterPath], {encoding: 'utf8'});
} catch (error) {
  diff = error.stdout;
}
fs.rmSync(tempRoot, {recursive: true, force: true});
if (!diff || !diff.includes('@@')) throw new Error('Diff generation failed');
const out = diff.split(/\r?\n/);
out[0] = 'diff --git a/lib/src/libgit2.dart b/lib/src/libgit2.dart';
for (let i = 0; i < out.length; i++) {
  if (out[i].startsWith('--- ')) out[i] = '--- a/lib/src/libgit2.dart';
  if (out[i].startsWith('+++ ')) out[i] = '+++ b/lib/src/libgit2.dart';
}
console.log(out.join('\n'));

