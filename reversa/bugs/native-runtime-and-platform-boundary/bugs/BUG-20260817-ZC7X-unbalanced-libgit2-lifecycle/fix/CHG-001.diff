diff --git a/test/libgit2_lifecycle_test.dart b/test/libgit2_lifecycle_test.dart
new file mode 100644
--- /dev/null
+++ b/test/libgit2_lifecycle_test.dart
@@ -0,0 +1,518 @@
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:git2dart/git2dart.dart';
+import 'package:git2dart/src/bindings/runtime.dart';
+import 'package:git2dart_binaries/git2dart_binaries.dart' hide Libgit2;
+import 'package:path/path.dart' as p;
+import 'package:test/test.dart';
+
+import 'helpers/util.dart';
+
+void main() {
+  group('Libgit2Runtime unit contract', () {
+    test('does not cache failed initialization', () {
+      var attempts = 0;
+      final runtime = Libgit2Runtime(
+        initializeNative: () => ++attempts == 1 ? -1 : 1,
+        shutdownNative: () => 0,
+        initializationError: () => Git2DartError('init failed'),
+      );
+
+      expect(() => runtime.withCall(() => 1), throwsA(isA<Git2DartError>()));
+      expect(runtime.isInitialized, isFalse);
+      expect(runtime.activeCallCount, 0);
+
+      expect(runtime.withCall(() => 42), 42);
+      expect(runtime.isInitialized, isTrue);
+      runtime.shutdown();
+      expect(runtime.isTerminated, isTrue);
+    });
+
+    test('rejects shutdown while an ownerless call is active', () {
+      final runtime = _fakeRuntime();
+
+      runtime.withCall(() {
+        expect(runtime.activeCallCount, 1);
+        expect(runtime.shutdown, throwsStateError);
+        expect(runtime.isTerminated, isFalse);
+      });
+
+      expect(runtime.activeCallCount, 0);
+      runtime.shutdown();
+      expect(runtime.isTerminated, isTrue);
+    });
+
+    test(
+      'destroys a persistent owner exactly once before releasing its pin',
+      () {
+        final runtime = _fakeRuntime();
+        var destroys = 0;
+        final owner =
+            runtime.acquireOwner()..bindDestructor(() {
+              destroys++;
+            });
+
+        expect(runtime.liveOwnerCount, 1);
+        expect(runtime.shutdown, throwsStateError);
+
+        owner.release();
+        owner.release();
+
+        expect(destroys, 1);
+        expect(runtime.liveOwnerCount, 0);
+        runtime.shutdown();
+      },
+    );
+
+    test('rolls back construction and transfers without destruction', () {
+      final runtime = _fakeRuntime();
+      var destroys = 0;
+
+      runtime.acquireOwner().rollbackConstruction();
+
+      final transferred =
+          runtime.acquireOwner()..bindDestructor(() {
+            destroys++;
+          });
+      transferred.transfer();
+      transferred.release();
+
+      expect(destroys, 0);
+      expect(runtime.liveOwnerCount, 0);
+      runtime.shutdown();
+    });
+
+    test('retains the pin when synchronous destruction fails', () {
+      final runtime = _fakeRuntime();
+      final failure = StateError('destructor failed');
+      final owner =
+          runtime.acquireOwner()..bindDestructor(() {
+            throw failure;
+          });
+
+      expect(owner.release, throwsA(same(failure)));
+      expect(runtime.liveOwnerCount, 1);
+      expect(runtime.shutdown, throwsStateError);
+    });
+
+    test('reports finalizer failure without releasing the pin or throwing', () {
+      final reported = <Object>[];
+      final runtime = _fakeRuntime(
+        onFinalizerError: (error, _) {
+          reported.add(error);
+        },
+      );
+      final failure = StateError('finalizer destructor failed');
+      final owner =
+          runtime.acquireOwner()..bindDestructor(() {
+            throw failure;
+          });
+
+      expect(owner.releaseFromFinalizer, returnsNormally);
+      expect(reported, [same(failure)]);
+      expect(runtime.liveOwnerCount, 1);
+      expect(runtime.shutdown, throwsStateError);
+    });
+  });
+
+  group('Libgit2 lifecycle integration', () {
+    test(
+      'reproduction: repeated public calls reuse one native lease',
+      () async {
+        final result = await Isolate.run(_exerciseStableCount);
+        final before = result['before']! as int;
+        final afterFirst = result['afterFirst']! as int;
+
+        expect(result['version'], '1.9.6');
+        expect(result['featuresPresent'], isTrue);
+        expect(afterFirst, before + 1);
+        expect(result['afterSecond'], afterFirst);
+        expect(result['afterGlobalOption'], afterFirst);
+        expect(result['afterShutdown'], before);
+        expect(result['afterRepeatedShutdown'], before);
+        expect(result['postShutdownRejected'], isTrue);
+      },
+    );
+
+    test('negative: a live root owner rejects shutdown unchanged', () async {
+      final result = await Isolate.run(_exerciseLiveRootOwner);
+
+      expect(result['shutdownError'], 'StateError');
+      expect(result['countAfterRejected'], result['countBeforeRejected']);
+      expect(result['repositoryStillUsable'], isTrue);
+      expect(result['countAfterShutdown'], result['baseline']);
+    });
+
+    test('regression: an owned child outlives its released parent', () async {
+      final result = await Isolate.run(_exerciseDerivedChildOwner);
+
+      expect(result['commitStillUsable'], isTrue);
+      expect(result['shutdownError'], 'StateError');
+      expect(result['countAfterRejected'], result['countBeforeRejected']);
+      expect(result['countAfterShutdown'], result['baseline']);
+    });
+
+    test('constructor failure rolls back its provisional owner', () async {
+      final result = await Isolate.run(_exerciseConstructorRollback);
+
+      expect(result['constructorError'], 'LibGit2Error');
+      expect(result['countAfterShutdown'], result['baseline']);
+    });
+
+    test('stream transfer releases its owner without destruction', () async {
+      final result = await Isolate.run(_exerciseStreamTransfer);
+
+      expect(result['oidLength'], 40);
+      expect(result['shutdownSucceededWithTransferredStreamAlive'], isTrue);
+      expect(result['countAfterShutdown'], result['baseline']);
+    });
+
+    test('two isolates own and release independent native leases', () async {
+      final baseline = _probeInitializationCount();
+      final first = await _RuntimeWorker.start();
+      _RuntimeWorker? second;
+
+      try {
+        final afterFirst = _probeInitializationCount();
+        second = await _RuntimeWorker.start();
+        final afterSecond = _probeInitializationCount();
+
+        expect(afterFirst, baseline + 1);
+        expect(afterSecond, afterFirst + 1);
+
+        await first.shutdown();
+        expect(_probeInitializationCount(), afterFirst);
+        expect(await second.request('version'), '1.9.6');
+
+        await second.shutdown();
+        expect(_probeInitializationCount(), baseline);
+      } finally {
+        await first.dispose();
+        await second?.dispose();
+      }
+    });
+  });
+}
+
+Libgit2Runtime _fakeRuntime({
+  void Function(Object error, StackTrace stackTrace)? onFinalizerError,
+}) {
+  return Libgit2Runtime(
+    initializeNative: () => 1,
+    shutdownNative: () => 0,
+    initializationError: () => Git2DartError('unexpected init failure'),
+    onFinalizerError: onFinalizerError,
+  );
+}
+
+int _probeInitializationCount() {
+  final count = libgit2.git_libgit2_init();
+  final restored = libgit2.git_libgit2_shutdown();
+  if (restored != count - 1) {
+    throw StateError('Probe did not restore the initialization count.');
+  }
+  return count;
+}
+
+Map<String, Object?> _exerciseStableCount() {
+  final before = _probeInitializationCount();
+  final version = Libgit2.version;
+  final afterFirst = _probeInitializationCount();
+  final featuresPresent = Libgit2.features.isNotEmpty;
+  final afterSecond = _probeInitializationCount();
+  final ownerValidation = Libgit2.ownerValidation;
+  final afterGlobalOption = _probeInitializationCount();
+
+  Libgit2.shutdown();
+  final afterShutdown = _probeInitializationCount();
+  Libgit2.shutdown();
+  final afterRepeatedShutdown = _probeInitializationCount();
+
+  var postShutdownRejected = false;
+  try {
+    Libgit2.version;
+  } on StateError {
+    postShutdownRejected = true;
+  }
+
+  return {
+    'before': before,
+    'version': version,
+    'featuresPresent': featuresPresent,
+    'ownerValidation': ownerValidation,
+    'afterFirst': afterFirst,
+    'afterSecond': afterSecond,
+    'afterGlobalOption': afterGlobalOption,
+    'afterShutdown': afterShutdown,
+    'afterRepeatedShutdown': afterRepeatedShutdown,
+    'postShutdownRejected': postShutdownRejected,
+  };
+}
+
+Map<String, Object?> _exerciseLiveRootOwner() {
+  final baseline = _probeInitializationCount();
+  final tmpDir = setupRepo(
+    Directory(p.join('test', 'assets', 'attributes_repo')),
+  );
+  final repo = Repository.open(tmpDir.path);
+  var repoFreed = false;
+  var runtimeShutdown = false;
+
+  try {
+    final countBeforeRejected = _probeInitializationCount();
+    String? shutdownError;
+    try {
+      Libgit2.shutdown();
+    } catch (error) {
+      shutdownError = error.runtimeType.toString();
+    }
+    final countAfterRejected = _probeInitializationCount();
+    final repositoryStillUsable = repo.path.isNotEmpty;
+
+    repo.free();
+    repoFreed = true;
+    Libgit2.shutdown();
+    runtimeShutdown = true;
+
+    return {
+      'baseline': baseline,
+      'shutdownError': shutdownError,
+      'countBeforeRejected': countBeforeRejected,
+      'countAfterRejected': countAfterRejected,
+      'repositoryStillUsable': repositoryStillUsable,
+      'countAfterShutdown': _probeInitializationCount(),
+    };
+  } finally {
+    if (!repoFreed) {
+      repo.free();
+    }
+    if (!runtimeShutdown) {
+      Libgit2.shutdown();
+    }
+    tmpDir.deleteSync(recursive: true);
+  }
+}
+
+Map<String, Object?> _exerciseDerivedChildOwner() {
+  final baseline = _probeInitializationCount();
+  final tmpDir = setupRepo(
+    Directory(p.join('test', 'assets', 'attributes_repo')),
+  );
+  final repo = Repository.open(tmpDir.path);
+  final oid = repo['d2f3abc9324a22a9f80fec2c131ec43c93430618'];
+  final commit = Commit.lookup(repo: repo, oid: oid);
+  var repoFreed = false;
+  var oidFreed = false;
+  var commitFreed = false;
+  var runtimeShutdown = false;
+
+  try {
+    oid.free();
+    oidFreed = true;
+    repo.free();
+    repoFreed = true;
+
+    final commitStillUsable = commit.message.isNotEmpty;
+    final countBeforeRejected = _probeInitializationCount();
+    String? shutdownError;
+    try {
+      Libgit2.shutdown();
+    } catch (error) {
+      shutdownError = error.runtimeType.toString();
+    }
+    final countAfterRejected = _probeInitializationCount();
+
+    commit.free();
+    commitFreed = true;
+    Libgit2.shutdown();
+    runtimeShutdown = true;
+
+    return {
+      'baseline': baseline,
+      'commitStillUsable': commitStillUsable,
+      'shutdownError': shutdownError,
+      'countBeforeRejected': countBeforeRejected,
+      'countAfterRejected': countAfterRejected,
+      'countAfterShutdown': _probeInitializationCount(),
+    };
+  } finally {
+    if (!commitFreed) {
+      commit.free();
+    }
+    if (!oidFreed) {
+      oid.free();
+    }
+    if (!repoFreed) {
+      repo.free();
+    }
+    if (!runtimeShutdown) {
+      Libgit2.shutdown();
+    }
+    tmpDir.deleteSync(recursive: true);
+  }
+}
+
+Map<String, Object?> _exerciseConstructorRollback() {
+  final baseline = _probeInitializationCount();
+  final tmpDir = Directory.systemTemp.createTempSync('git2dart-runtime-');
+  var runtimeShutdown = false;
+
+  try {
+    String? constructorError;
+    try {
+      Repository.open(p.join(tmpDir.path, 'missing'));
+    } catch (error) {
+      constructorError = error.runtimeType.toString();
+    }
+
+    Libgit2.shutdown();
+    runtimeShutdown = true;
+    return {
+      'baseline': baseline,
+      'constructorError': constructorError,
+      'countAfterShutdown': _probeInitializationCount(),
+    };
+  } finally {
+    if (!runtimeShutdown) {
+      Libgit2.shutdown();
+    }
+    tmpDir.deleteSync(recursive: true);
+  }
+}
+
+Map<String, Object?> _exerciseStreamTransfer() {
+  final baseline = _probeInitializationCount();
+  final tmpDir = setupRepo(
+    Directory(p.join('test', 'assets', 'attributes_repo')),
+  );
+  final repo = Repository.open(tmpDir.path);
+  final stream = Blob.createFromStream(repo: repo);
+  Oid? oid;
+  var repoFreed = false;
+  var oidFreed = false;
+  var runtimeShutdown = false;
+
+  try {
+    stream.writeString('lifecycle transfer');
+    oid = Blob.createFromStreamCommit(stream);
+    final oidLength = oid.sha.length;
+
+    oid.free();
+    oidFreed = true;
+    repo.free();
+    repoFreed = true;
+    Libgit2.shutdown();
+    runtimeShutdown = true;
+
+    return {
+      'baseline': baseline,
+      'oidLength': oidLength,
+      'shutdownSucceededWithTransferredStreamAlive': true,
+      'countAfterShutdown': _probeInitializationCount(),
+    };
+  } finally {
+    if (oid != null && !oidFreed) {
+      oid.free();
+    }
+    if (!repoFreed) {
+      repo.free();
+    }
+    if (!runtimeShutdown) {
+      Libgit2.shutdown();
+    }
+    tmpDir.deleteSync(recursive: true);
+  }
+}
+
+void _runtimeWorkerMain(SendPort ready) {
+  final commands = ReceivePort();
+  final version = Libgit2.version;
+  ready.send([commands.sendPort, version]);
+
+  commands.listen((message) {
+    final values = message! as List<Object?>;
+    final command = values[0]! as String;
+    final reply = values[1]! as SendPort;
+
+    try {
+      if (command == 'version') {
+        reply.send(['ok', Libgit2.version]);
+      } else if (command == 'shutdown') {
+        Libgit2.shutdown();
+        reply.send(['ok', null]);
+        commands.close();
+      } else {
+        throw ArgumentError.value(command, 'command');
+      }
+    } catch (error) {
+      reply.send(['error', error.toString()]);
+    }
+  });
+}
+
+final class _RuntimeWorker {
+  _RuntimeWorker._(this.isolate, this.commands, this.exitPort, this.version);
+
+  final Isolate isolate;
+  final SendPort commands;
+  final ReceivePort exitPort;
+  final String version;
+  bool _closed = false;
+
+  static Future<_RuntimeWorker> start() async {
+    final ready = ReceivePort();
+    final exit = ReceivePort();
+    final isolate = await Isolate.spawn(
+      _runtimeWorkerMain,
+      ready.sendPort,
+      onExit: exit.sendPort,
+    );
+    final values = await ready.first as List<Object?>;
+    ready.close();
+
+    return _RuntimeWorker._(
+      isolate,
+      values[0]! as SendPort,
+      exit,
+      values[1]! as String,
+    );
+  }
+
+  Future<Object?> request(String command) async {
+    final reply = ReceivePort();
+    commands.send([command, reply.sendPort]);
+    final response = await reply.first as List<Object?>;
+    reply.close();
+
+    if (response[0] == 'error') {
+      throw StateError(response[1]! as String);
+    }
+    return response[1];
+  }
+
+  Future<void> shutdown() async {
+    if (_closed) {
+      return;
+    }
+    await request('shutdown');
+    await exitPort.first;
+    exitPort.close();
+    _closed = true;
+  }
+
+  Future<void> dispose() async {
+    if (_closed) {
+      return;
+    }
+    try {
+      await shutdown();
+    } finally {
+      if (!_closed) {
+        isolate.kill(priority: Isolate.immediate);
+        exitPort.close();
+        _closed = true;
+      }
+    }
+  }
+}

