diff --git a/lib/src/index.dart b/lib/src/index.dart
--- a/lib/src/index.dart
+++ b/lib/src/index.dart
@@
-  const IndexEntry(this._indexEntryPointer);
-  final Pointer<git_index_entry> _indexEntryPointer;
+  IndexEntry(Pointer<git_index_entry> pointer)
+    : _owner = pointer == nullptr ? null : _IndexEntryOwner(bindings.copyEntry(pointer)) {
+    final owner = _owner;
+    if (owner != null) _indexEntryFinalizer.attach(this, owner, detach: this);
+  }
+  final _IndexEntryOwner? _owner;
